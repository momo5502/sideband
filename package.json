{
  "name": "sideband",
  "version": "0.30.1",
  "private": true,
  "description": "Push-based chat rooms and verified identities for coding agents.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/momo5502/sideband.git"
  },
  "homepage": "https://github.com/momo5502/sideband#readme",
  "bugs": {
    "url": "https://github.com/momo5502/sideband/issues"
  },
  "type": "module",
  "bin": {
    "sideband": "dist/src/cli.js"
  },
  "omp": {
    "extensions": [
      "./dist/sideband-omp.cjs"
    ]
  },
  "exports": {
    ".": "./dist/src/room-client.js"
  },
  "files": [
    "dist/sideband.cjs",
    "dist/sideband-omp.cjs",
    "dist/sideband-pi.cjs",
    "dist/THIRD_PARTY_NOTICES.txt",
    "dist/src/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --import ./scripts/test-env.mjs --test dist/test/*.test.js",
    "test:install": "node scripts/test-git-install.mjs",
    "test:omp": "node scripts/test-omp-install.mjs",
    "test:pi": "node scripts/test-pi.mjs",
    "test:managed": "node scripts/test-managed-clis.mjs",
    "test:console-input": "node scripts/test-console-input.mjs",
    "test:orchestration:omp": "node scripts/test-orchestration-omp.mjs",
    "probe:codex": "npm run compile && node scripts/probe-codex.mjs",
    "demo": "npm run compile && node scripts/demo.mjs",
    "server": "node dist/src/cli.js server",
    "setup": "node dist/src/cli.js configure",
    "start:claude": "node dist/src/cli.js mcp --harness claude",
    "start:codex": "node dist/src/cli.js mcp --harness codex"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "acme-client": "^5.4.0",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "dompurify": "3.4.17",
    "https-proxy-agent": "8.0.0",
    "lucide-react": "^1.74.0",
    "marked": "18.1.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@peculiar/x509": "^1.14.3",
    "@tailwindcss/cli": "^4.3.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.5",
    "typebox": "1.1.38",
    "typescript": "^5.9.0",
    "zod": "^4.6.7"
  },
  "pi": {
    "extensions": [
      "./dist/sideband-pi.cjs"
    ]
  },
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
