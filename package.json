{
  "name": "sideband",
  "version": "0.8.1",
  "private": true,
  "description": "Push-based chat rooms and verified identities for coding agents.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/momo5502/sideband.git"
  },
  "homepage": "https://github.com/momo5502/sideband#readme",
  "bugs": {
    "url": "https://github.com/momo5502/sideband/issues"
  },
  "type": "module",
  "bin": {
    "sideband": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/room-client.js"
  },
  "files": [
    "dist/sideband.cjs",
    "dist/THIRD_PARTY_NOTICES.txt",
    "dist/src/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --import ./scripts/test-env.mjs --test dist/test/*.test.js",
    "test:install": "node scripts/test-git-install.mjs",
    "probe:codex": "npm run compile && node scripts/probe-codex.mjs",
    "demo": "npm run compile && node scripts/demo.mjs",
    "server": "node dist/src/cli.js server",
    "setup": "node dist/src/cli.js configure",
    "start:claude": "node dist/src/cli.js mcp --harness claude",
    "start:codex": "node dist/src/cli.js mcp --harness codex"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "https-proxy-agent": "8.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "^5.9.0",
    "zod": "^4.6.7"
  }
}
